                <details class="vbw-handoff-troubleshoot">
                    <summary>Modal didn&rsquo;t open?</summary>
                    <ul>
                        <li>The current domain must be in the allowed-origins list of your Web Checkout connection in Ventrata. The SDK authenticates by origin/referer, not by API key.</li>
                        <li>Disable ad blockers / privacy extensions, then reload the page.</li>
                        <li>Open your browser console: <code>CHECKOUT_HOST_REQUIRES_CHECKOUT_CONNECTION</code> means this domain is not registered with Ventrata.</li>
                    </ul>
                </details>
                <button type="button" class="vbw-booking-back vbw-handoff-close">Close</button>
            </div>`;
            const closeBtn = this.bookingPanel.querySelector('.vbw-handoff-close');
            if (closeBtn) closeBtn.addEventListener('click', () => this.closeModal());
        }

        renderHandoffNotConfigured() {
            this.bookingPanel.innerHTML = `
            <div class="vbw-handoff-status">
                <h3 class="vbw-handoff-title">Checkout SDK not available on this page</h3>
                <p>The Ventrata Checkout SDK (<code>ventrata-checkout.min.js</code>) is not loaded here, so we cannot open the booking modal.</p>
                <p>Pick one of:</p>
                <ul>
                    <li>Have your theme load the SDK script tag on this URL (recommended if your theme already loads it on other pages).</li>
                    <li>Or open Settings → Ventrata Booking and set <strong>Inject SDK script</strong> to "Yes" and provide a valid Checkout API key.</li>
                </ul>
                <button type="button" class="vbw-booking-back vbw-handoff-close">Close</button>
            </div>`;
            const closeBtn = this.bookingPanel.querySelector('.vbw-handoff-close');
            if (closeBtn) closeBtn.addEventListener('click', () => this.closeModal());
        }

        renderHandoffStatusWithErrors(errors) {
            const originRejected = errors.some((e) =>
                String(e.errorCode || '').toUpperCase().includes('CHECKOUT_HOST_REQUIRES_CHECKOUT_CONNECTION')
                || String(e.errorMessage || '').toLowerCase().includes('checkout connection')
            );
            const currentOrigin = (typeof window !== 'undefined' && window.location && window.location.origin) ? window.location.origin : 'this domain';
            const advice = originRejected
                ? `<div class="vbw-handoff-advice"><strong>Action required:</strong> Ventrata rejected the request because <code>${this.esc(currentOrigin)}</code> isn't registered as an allowed origin for your Web Checkout connection. The SDK authenticates by domain (origin/referer), not by API key — so the same key that works on a registered domain (e.g. your staging site) will fail here until this domain is added.<br/><br/>Ask Ventrata to add <code>${this.esc(currentOrigin)}</code> to the allowed-origins list of the Web Checkout connection in your dashboard, then reload this page.</div>`
                : `<div class="vbw-handoff-advice"><strong>Action required:</strong> Ventrata rejected the request. Check the Checkout settings on Ventrata's dashboard (allowed origins, connection status) and try again.</div>`;

            const list = errors.map((e) => {
                const code = e.errorCode ? `<code>${this.esc(e.errorCode)}</code>` : '';
                const msg = this.esc(e.errorMessage || '');
                const status = e.status ? ` <span class="vbw-handoff-status-code">[${e.status}]</span>` : '';
                return `<li>${code}${status} ${msg}</li>`;
            }).join('');

            this.bookingPanel.innerHTML = `
            <div class="vbw-handoff-status">
                <h3 class="vbw-handoff-title">Checkout could not open</h3>
                ${advice}
                <details class="vbw-handoff-troubleshoot" open>
                    <summary>Errors returned by Ventrata</summary>
                    <ul class="vbw-handoff-errors">${list}</ul>
                </details>
                <button type="button" class="vbw-booking-back vbw-handoff-close">Close</button>
            </div>`;
            const closeBtn = this.bookingPanel.querySelector('.vbw-handoff-close');
            if (closeBtn) closeBtn.addEventListener('click', () => this.closeModal());
        }

        /* -----------------------------------------------------------------
         * UI Helpers
         * -------------------------------------------------------------- */

        showPanel(panel) {
            if (!panel || !panel.classList) return;
            panel.classList.add('is-visible');
            this.openModal();
        }

        hidePanel(panel) {
            if (!panel || !panel.classList) return;
            panel.classList.remove('is-visible');
            if (!this.hasVisibleModalContent()) {
                this.closeModal();
            }
        }

        showLoader() {
            if (!this.loader || !this.loader.classList) return;
            this.loader.classList.add('is-visible');
            this.openModal();
        }

        hideLoader() {
            if (!this.loader || !this.loader.classList) return;
            this.loader.classList.remove('is-visible');
            if (!this.hasVisibleModalContent()) {
                this.closeModal();
            }
        }

        hasVisibleModalContent() {
            return [this.resultsPanel, this.bookingPanel, this.loader]
                .some((el) => el && el.classList.contains('is-visible'));
        }

        openModal() {
            if (!this.modal) return;
            this.modal.classList.add('is-open');
            this.modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('vbw-modal-open');
        }

        closeModal() {
            if (!this.modal) return;
            this.modal.classList.remove('is-open');
            this.modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('vbw-modal-open');
            [this.resultsPanel, this.bookingPanel, this.loader].forEach((el) => {
                if (el) el.classList.remove('is-visible');
            });
        }

        showError(msg) {
            this.clearError();
            const el = document.createElement('div');
            el.className = 'vbw-error';
            el.textContent = msg;
			const modalBody = this.modal?.querySelector('.vbw-modal-body');
            const panel = this.bookingPanel?.classList.contains('is-visible')
                ? this.bookingPanel
                : this.resultsPanel?.classList.contains('is-visible')
                    ? this.resultsPanel
                        : null;

            if (modalBody && this.modal?.classList.contains('is-open')) {
                if (panel) {
                    panel.insertAdjacentElement('afterbegin', el);
                } else {
                    modalBody.insertAdjacentElement('afterbegin', el);
                }
                this.openModal();
                return;
            }

            this.el.querySelector('.vbw-search-bar').insertAdjacentElement('afterend', el);
        }

        clearError() {
            this.el.querySelectorAll('.vbw-error').forEach((err) => err.remove());
        }

        /* -----------------------------------------------------------------
         * Formatting
         * -------------------------------------------------------------- */

        formatDate(date) {
            const d = date instanceof Date ? date : new Date(date);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        formatDateLabel(dateStr) {
            const d = new Date(dateStr + 'T12:00:00');
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        formatTime(dateTimeStr) {
            if (!dateTimeStr) return '';
            const timePart = dateTimeStr.includes('T') ? dateTimeStr.split('T')[1] : null;
            if (!timePart) return '';
            const [h, m] = timePart.split(':').map(Number);
            const suffix = h >= 12 ? 'PM' : 'AM';
            const hour12 = h % 12 || 12;
            return `${hour12}:${String(m).padStart(2, '0')} ${suffix}`;
        }

        formatCurrency(amountInCents, currency = 'USD') {
            const precision = currency === 'USD' ? 2 : 2;
            const amount = amountInCents / Math.pow(10, precision);
            return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount);
        }

        esc(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        /* -----------------------------------------------------------------
         * API calls via WordPress AJAX
         * -------------------------------------------------------------- */

        async api(action, data = {}) {
            const formData = new FormData();
            formData.append('action', `ventrata_${action}`);
            formData.append('nonce', ventrataConfig.nonce);
            Object.entries(data).forEach(([key, val]) => formData.append(key, val));

            try {
                const response = await fetch(ventrataConfig.ajaxUrl, {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin',
                });
                return await response.json();
            } catch (e) {
                return { success: false, data: { message: 'Network error. Please check your connection.' } };
            }
        }
    }

    /* =================================================================
     * VentrataSchedule – "Today on the Water" schedule listing
     * ================================================================= */

    class VentrataSchedule {
        constructor(container) {
            this.el = container;
            this.date = this.el.dataset.date || new Date().toISOString().slice(0, 10);
            this.maxItems = parseInt(this.el.dataset.maxItems, 10) || 10;
            this.allSlots = [];
            this.activeFilter = 'All';
            this.expanded = false;

            this.filtersEl = this.el.querySelector('.vbw-schedule-filters');
            this.dateLabel = this.el.querySelector('.vbw-schedule-date-label');
            this.listEl = this.el.querySelector('.vbw-schedule-list');
            this.loader = this.el.querySelector('.vbw-loader');
            this.toggleBtn = this.el.querySelector('.vbw-schedule-cta--toggle');

            if (this.toggleBtn) {
                this.toggleBtn.addEventListener('click', () => this.toggleExpand());
            }

            this.load();
        }

        async load() {
            this.showLoader();
            const res = await this.api('get_schedule', { date: this.date });
            this.hideLoader();

            if (!res.success) {
                this.listEl.innerHTML = '<div class="vbw-no-results">Could not load schedule.</div>';
                return;
            }

            this.allSlots = (res.data || []).filter((s) => s.available);
            this.renderDateLabel();
            this.buildFilters();
            this.renderList();
        }

        /* ---------- Date label ---------- */

        renderDateLabel() {
            const d = new Date(this.date + 'T12:00:00');
            const label = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
            this.dateLabel.textContent = label;
        }

        /* ---------- Category detection ---------- */

        getCategory(slot) {
            const name = (slot.productName || '').toLowerCase();
            if (name.includes('architecture')) return 'Architecture';
            if (name.includes('lake') || name.includes('skyline')) return 'Lake';
            if (name.includes('water taxi') || name.includes('taxi')) return 'Water Taxi';
            if (name.includes('firework')) return 'Fireworks';
            if (name.includes('shoreline')) return 'Water Taxi';
            return 'Other';
        }

        getCategoryColor(cat) {
            const map = {
                Architecture: '#1e3a5f',
                Lake: '#3b7dd8',
                'Water Taxi': '#27ae60',
                Fireworks: '#e8602c',
                Other: '#6b7a8d',
            };
            return map[cat] || map.Other;
        }

        /* ---------- Filters ---------- */

        buildFilters() {
            const categories = ['All'];
            this.allSlots.forEach((s) => {
                const cat = this.getCategory(s);
                if (!categories.includes(cat)) categories.push(cat);
            });

            if (categories.length <= 2) {
                this.filtersEl.style.display = 'none';
                return;
            }

            this.filtersEl.innerHTML = categories
                .map((c) => `<button type="button" class="vbw-filter-pill${c === this.activeFilter ? ' is-active' : ''}" data-cat="${this.esc(c)}">${this.esc(c)}</button>`)
                .join('');

            this.filtersEl.querySelectorAll('.vbw-filter-pill').forEach((btn) => {
                btn.addEventListener('click', () => {
                    this.activeFilter = btn.dataset.cat;
                    this.filtersEl.querySelectorAll('.vbw-filter-pill').forEach((b) => b.classList.toggle('is-active', b === btn));
                    this.renderList();
                });
            });
        }

        /* ---------- List rendering ---------- */

        renderList() {
            let slots = this.activeFilter === 'All'
                ? this.allSlots
                : this.allSlots.filter((s) => this.getCategory(s) === this.activeFilter);

            const limit = this.expanded ? slots.length : this.maxItems;
            const visible = slots.slice(0, limit);

            if (!visible.length) {
                this.listEl.innerHTML = '<div class="vbw-no-results">No tours scheduled for this date.</div>';
                if (this.toggleBtn) this.toggleBtn.style.display = 'none';
                return;
            }

            this.listEl.innerHTML = visible.map((slot) => {
                const cat = this.getCategory(slot);
                const color = this.getCategoryColor(cat);
                const time = this.formatTime(slot.localDateTimeStart);
                const badge = this.getBadge(slot);
                const displayName = this.getDisplayName(slot);

                return `
                <div class="vbw-sched-row" style="border-left-color:${color}">
                    <div class="vbw-sched-left">
                        <span class="vbw-sched-time">${time}</span>
                        <span class="vbw-sched-sep">&mdash;</span>
                        <span class="vbw-sched-name">${this.esc(displayName)}</span>
                    </div>
                    <div class="vbw-sched-badge ${badge.cls}">${this.esc(badge.text)}</div>
                </div>`;
            }).join('');

            if (this.toggleBtn) {
                this.toggleBtn.style.display = slots.length > this.maxItems ? '' : 'none';
                this.toggleBtn.textContent = this.expanded ? 'SHOW LESS' : 'VIEW FULL SCHEDULE';
            }
        }

        getDisplayName(slot) {
            const option = slot.optionName || '';
            const product = slot.productName || '';
            // Prefer the option's cleaned internalName so variants like
            // "90-Minute Architecture Tour from Navy Pier" or "Spanish ..."
            // surface in the schedule. Fall back to product when the option
            // is empty or literally "DEFAULT".
            if (option && option !== 'DEFAULT') {
                return option;
            }
            return product;
        }

        getBadge(slot) {
            if (!slot.available) return { text: 'Sold out', cls: 'vbw-badge--soldout' };
            if (slot.vacancies != null && slot.vacancies <= 10) return { text: 'Limited seats', cls: 'vbw-badge--limited' };
            if (slot.vacancies != null && slot.vacancies <= 30) return { text: 'Filling up', cls: 'vbw-badge--filling' };
            return { text: 'Available', cls: 'vbw-badge--available' };
        }

        toggleExpand() {
            this.expanded = !this.expanded;
            this.renderList();
        }

        /* ---------- Helpers ---------- */

        formatTime(dateTimeStr) {
            if (!dateTimeStr) return '';
            const timePart = dateTimeStr.includes('T') ? dateTimeStr.split('T')[1] : null;
            if (!timePart) return '';
            const [h, m] = timePart.split(':').map(Number);
            const suffix = h >= 12 ? 'PM' : 'AM';
            const hour12 = h % 12 || 12;
            return `${hour12}:${String(m).padStart(2, '0')} ${suffix}`;
        }

        esc(str) {
            const div = document.createElement('div');
            div.textContent = str || '';
            return div.innerHTML;
        }

        showLoader() { if (this.loader && this.loader.classList) this.loader.classList.add('is-visible'); }
        hideLoader() { if (this.loader && this.loader.classList) this.loader.classList.remove('is-visible'); }

        async api(action, data = {}) {
            const formData = new FormData();
            formData.append('action', `ventrata_${action}`);
            formData.append('nonce', ventrataConfig.nonce);
            Object.entries(data).forEach(([key, val]) => formData.append(key, val));
            try {
                const response = await fetch(ventrataConfig.ajaxUrl, { method: 'POST', body: formData, credentials: 'same-origin' });
                return await response.json();
            } catch (e) {
                return { success: false, data: { message: 'Network error.' } };
            }
        }
    }

    /* =================================================================
     * VentrataRouteSchedule – Route status table
     * ================================================================= */

    class VentrataRouteSchedule {
        constructor(container) {
            this.el = container;
            this.date = this.el.dataset.date || new Date().toISOString().slice(0, 10);
            this.defaultStatus = this.el.dataset.defaultStatus || 'Not operating this day';
            this.routes = [];

            try {
                this.routes = JSON.parse(this.el.dataset.routes || '[]');
            } catch (e) {
                this.routes = [];
            }

            this.rowsEl = this.el.querySelector('.vbw-route-rows');
            this.loader = this.el.querySelector('.vbw-loader');

            this.load();
        }

        async load() {
            if (!this.routes.length) {
                this.rowsEl.innerHTML = '<div class="vbw-no-results">No routes configured.</div>';
                return;
            }

            const needsRouteStatusApi = this.routes.some((r) => {
                if (r.status) return false;
                if (r.product_id && r.option_id) return true;
                return Boolean(r.name && String(r.name).trim());
            });

            if (needsRouteStatusApi) {
                this.showLoader();
                const res = await this.api('get_route_status', {
                    date: this.date,
                    routes: JSON.stringify(this.routes),
                });
                this.hideLoader();

                if (res.success) {
                    this.render(res.data);
                    return;
                }
            }

            this.render(this.routes.map((r) => ({
                name: r.name || '',
                operating: false,
                status: r.status || '',
                times: [],
            })));
        }

        render(routeData) {
            if (!routeData.length) {
                this.rowsEl.innerHTML = '<div class="vbw-no-results">No routes available.</div>';
                return;
            }

            this.rowsEl.innerHTML = routeData.map((route) => {
                const statusText = this.getStatusText(route);
                const statusCls = route.operating ? 'vbw-route-status--active' : 'vbw-route-status--inactive';

                return `
                <div class="vbw-route-row">
                    <span class="vbw-route-name">${this.esc(route.name)}</span>
                    <span class="vbw-route-status ${statusCls}">${this.esc(statusText)}</span>
                </div>`;
            }).join('');
        }

        getStatusText(route) {
            if (route.status) return route.status;

            if (!route.operating || !Array.isArray(route.opening_hours) || !route.opening_hours.length) {
                return this.defaultStatus;
            }

            const text = route.opening_hours
                .map((range) => {
                    const from = this.formatTime(range && range.from);
                    const to   = this.formatTime(range && range.to);
                    return from && to ? `${from} – ${to}` : '';
                })
                .filter(Boolean)
                .join(', ');

            return text || this.defaultStatus;
        }

        formatTime(input) {
            if (!input) return '';
            const str = String(input);
            const timePart = str.includes('T') ? str.split('T')[1] : str;
            if (!timePart) return '';
            const [h, m] = timePart.split(':').map(Number);
            if (Number.isNaN(h) || Number.isNaN(m)) return '';
            const suffix = h >= 12 ? 'PM' : 'AM';
            const hour12 = h % 12 || 12;
            return `${hour12}:${String(m).padStart(2, '0')} ${suffix}`;
        }

        esc(str) {
            const div = document.createElement('div');
            div.textContent = str || '';
            return div.innerHTML;
        }

        showLoader() { if (this.loader && this.loader.classList) this.loader.classList.add('is-visible'); }
        hideLoader() { if (this.loader && this.loader.classList) this.loader.classList.remove('is-visible'); }

        async api(action, data = {}) {
            const formData = new FormData();
            formData.append('action', `ventrata_${action}`);
            formData.append('nonce', ventrataConfig.nonce);
            Object.entries(data).forEach(([key, val]) => formData.append(key, val));
            try {
                const response = await fetch(ventrataConfig.ajaxUrl, { method: 'POST', body: formData, credentials: 'same-origin' });
                return await response.json();
            } catch (e) {
                return { success: false, data: { message: 'Network error.' } };
            }
        }
    }

