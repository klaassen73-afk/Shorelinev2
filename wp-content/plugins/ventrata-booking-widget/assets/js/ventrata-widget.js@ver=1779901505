    class VentrataQuote {
        constructor(container) {
            this.el = container;
            this.successMessage = this.el.dataset.successMessage || 'Thank you! We will get back to you shortly.';

            this.dateInput = this.el.querySelector('.vbw-quote-date-input');
            this.eventType = this.el.querySelector('[name="event_type"]');
            this.budgetRange = this.el.querySelector('[name="budget_range"]');
            this.groupSize = this.el.querySelector('[name="group_size"]');
            this.submitBtn = this.el.querySelector('.vbw-quote-submit');
            this.resultEl = this.el.querySelector('.vbw-quote-result');
            this.loader = this.el.querySelector('.vbw-loader');

            this.originalBtnText = this.submitBtn.textContent;
            this.initDatePicker();
            this.submitBtn.addEventListener('click', () => this.submit());
        }

        initDatePicker() {
            this.datepicker = flatpickr(this.dateInput, {
                mode: 'range',
                dateFormat: 'Y-m-d',
                altInput: true,
                altFormat: 'M j, Y',
                minDate: 'today',
            });
        }

        async submit() {
            this.hideResult();

            const dateRange = this.dateInput.value;
            const eventType = this.eventType.value;
            const budget = this.budgetRange.value;
            const groupSize = this.groupSize.value;

            if (!dateRange) { this.showResult('Please select a date or date range.', true); return; }
            if (!eventType) { this.showResult('Please select an event type.', true); return; }
            if (!groupSize || parseInt(groupSize, 10) < 1) { this.showResult('Please enter a valid group size.', true); return; }

            this.submitBtn.disabled = true;
            this.submitBtn.textContent = 'Sending…';

            const res = await this.api('submit_quote', {
                date_range: dateRange,
                event_type: eventType,
                budget_range: budget,
                group_size: groupSize,
            });

            this.submitBtn.disabled = false;
            this.submitBtn.textContent = this.originalBtnText;

            if (res.success) {
                this.showResult(this.successMessage, false);
            } else {
                this.showResult(res.data?.message || 'Something went wrong. Please try again.', true);
            }
        }

        showResult(msg, isError) {
            this.resultEl.textContent = msg;
            this.resultEl.className = 'vbw-quote-result is-visible ' + (isError ? 'vbw-quote-error' : 'vbw-quote-success');
        }

        hideResult() {
            this.resultEl.className = 'vbw-quote-result';
            this.resultEl.textContent = '';
        }

        async api(action, data = {}) {
            const formData = new FormData();
            formData.append('action', `ventrata_${action}`);
            formData.append('nonce', ventrataConfig.nonce);
            Object.entries(data).forEach(([key, val]) => formData.append(key, val));
            try {
                const response = await fetch(ventrataConfig.ajaxUrl, { method: 'POST', body: formData, credentials: 'same-origin' });
                return await response.json();
            } catch (e) {
                return { success: false, data: { message: 'Network error.' } };
            }
        }
    }

    /* =================================================================
     * VentrataBookingBar – Compact inline booking search bar
     * ================================================================= */

    class VentrataBookingBar {
        constructor(container) {
            this.el = container;
            this.products = [];
            this.selectedProduct = null;
            this.selectedOption = null;
            this.selectedDate = null;
            this.units = [];
            this.datepicker = null;
            this.availableDates = [];
            this.currentBookingUuid = null;
            this.currentSlotData = null;

            this.presetProductId = this.el.dataset.productId || '';
            this.presetOptionId = this.el.dataset.optionId || '';
            this.staticLocations = (this.el.dataset.locations || '').split(',').map(s => s.trim()).filter(Boolean);

            this.experienceSelect = this.el.querySelector('.vbw-bar-experience');
            this.locationSelect = this.el.querySelector('.vbw-bar-location');
            this.dateInput = this.el.querySelector('.vbw-bar-date');
            this.findBtn = this.el.querySelector('.vbw-bar-btn');
            this.resultsPanel = this.el.querySelector('.vbw-results');
            this.bookingPanel = this.el.querySelector('.vbw-booking-panel');
            this.loader = this.el.querySelector('.vbw-loader');

            this.experienceSelect.addEventListener('change', () => this.onExperienceChange());
            this.findBtn.addEventListener('click', () => this.findTimes());

            this.loadProducts();
        }

        async loadProducts() {
            const res = await this.api('get_products');
            if (!res.success) {
                this.showError('Could not load experiences.');
                return;
            }
            this.products = res.data;
            this.populateExperiences();
        }

        populateExperiences() {
            this.experienceSelect.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Select';
            this.experienceSelect.appendChild(placeholder);

            this.products.forEach((product) => {
                if (this.presetProductId && product.id !== this.presetProductId) return;

                // Round-trip water-taxi products are bookable through the dock
                // pages, not the experience dropdown — exclude them here.
                const productLabel = product.title || product.internalName || '';
                if (/^Round-trip/i.test(productLabel)) return;

                const options = product.options || [];
                if (options.length <= 1) {
                    const opt = document.createElement('option');
                    const option = options[0] || {};
                    opt.value = JSON.stringify({ productId: product.id, optionId: option.id || 'DEFAULT' });
                    opt.textContent = product.title || product.internalName;
                    if (this.presetOptionId && option.id === this.presetOptionId) opt.selected = true;
                    this.experienceSelect.appendChild(opt);
                } else {
                    const group = document.createElement('optgroup');
                    group.label = product.title || product.internalName;
                    options.forEach((option) => {
                        if (this.presetOptionId && option.id !== this.presetOptionId) return;
                        const opt = document.createElement('option');
                        opt.value = JSON.stringify({ productId: product.id, optionId: option.id });
                        opt.textContent = option.title || option.internalName;
                        if (this.presetOptionId && option.id === this.presetOptionId) opt.selected = true;
                        group.appendChild(opt);
                    });
                    this.experienceSelect.appendChild(group);
                }
            });

            if (this.staticLocations.length) {
                this.populateLocations(this.staticLocations);
            }

            if (this.presetProductId) {
                const firstReal = this.experienceSelect.querySelector('option[value]:not([value=""])');
                if (firstReal) firstReal.selected = true;
                this.onExperienceChange();
            }
        }

        populateLocations(names) {
            this.locationSelect.innerHTML = '';
            const all = document.createElement('option');
            all.value = '';
            all.textContent = 'All';
            this.locationSelect.appendChild(all);

            names.forEach((name) => {
                const opt = document.createElement('option');
                opt.value = name;
                opt.textContent = name;
                this.locationSelect.appendChild(opt);
            });
        }

        onExperienceChange() {
            const val = this.experienceSelect.value;
            if (!val) return;

            const { productId, optionId } = JSON.parse(val);
            this.selectedProduct = productId;
            this.selectedOption = optionId;

            const product = this.products.find((p) => p.id === productId);
            const option = (product?.options || []).find((o) => o.id === optionId);

            this.buildUnits(option);

            if (!this.staticLocations.length && product) {
                const optionNames = (product.options || [])
                    .map((o) => o.title || o.internalName)
                    .filter((n) => n && n !== 'DEFAULT');
                if (optionNames.length > 1) {
                    this.populateLocations(optionNames);
                }
            }

            this.loadCalendar(productId, optionId);
            this.hidePanel(this.resultsPanel);
            this.hidePanel(this.bookingPanel);
        }

        buildUnits(option) {
            if (!option) return;
            this.units = (option.units || []).map((u) => ({
                id: u.id,
                name: u.internalName,
                type: u.type,
                quantity: u.type === 'ADULT' ? 2 : 0,
            }));
        }

        async loadCalendar(productId, optionId) {
            this.dateInput.value = '';
            this.selectedDate = null;
            if (this.datepicker) this.datepicker.destroy();

            const res = await this.api('get_calendar', { product_id: productId, option_id: optionId });
            if (!res.success) return;

            this.availableDates = (res.data || []).filter((d) => d.available).map((d) => d.localDate);

            const today = new Date().toISOString().slice(0, 10);
            const todayAvailable = this.availableDates.includes(today);

            this.datepicker = flatpickr(this.dateInput, {
                dateFormat: 'Y-m-d',
                altInput: true,
                altFormat: 'M j',
                minDate: 'today',
                enable: this.availableDates,
                onChange: (dates) => {
                    if (dates[0]) {
                        const iso = this.formatDate(dates[0]);
                        this.selectedDate = iso;
                        const todayStr = new Date().toISOString().slice(0, 10);
                        if (iso === todayStr && this.datepicker?.altInput) {
                            this.datepicker.altInput.value = 'Today';
                        }
                    }
                },
            });

            if (todayAvailable) {
                this.datepicker.setDate(today, true);
                this.selectedDate = today;
                if (this.datepicker.altInput) this.datepicker.altInput.value = 'Today';
            } else if (this.availableDates.length > 0) {
                this.datepicker.setDate(this.availableDates[0], true);
                this.selectedDate = this.availableDates[0];
            }
        }

        async findTimes() {
            if (!this.selectedProduct || !this.selectedOption) {
                this.showError('Please select an experience.');
                return;
            }
            if (!this.selectedDate) {
                this.showError('Please select a date.');
                return;
            }

            this.clearError();
            this.hidePanel(this.resultsPanel);
            this.hidePanel(this.bookingPanel);
            this.showLoader();

            const res = await this.api('get_availability', {
                product_id: this.selectedProduct,
                option_id: this.selectedOption,
                date: this.selectedDate,
            });

            this.hideLoader();

            if (!res.success) {
                this.showError('Could not load availability. Please try again.');
                return;
            }

            this.renderSlots(res.data || []);
        }

        renderSlots(slots) {
            if (!slots.length) {
                this.resultsPanel.innerHTML = '<div class="vbw-no-results">No available times for this date.</div>';
                this.showPanel(this.resultsPanel);
                return;
            }

            const dateLabel = this.formatDateLabel(this.selectedDate);
            let html = `<h3 class="vbw-results-heading">Available Times &mdash; ${this.esc(dateLabel)}</h3><div class="vbw-slots">`;

            slots.forEach((slot) => {
                const time = this.formatTime(slot.localDateTimeStart || slot.localDate);
                const status = this.slotStatus(slot);

                html += `
                <div class="vbw-slot" data-availability-id="${this.esc(slot.id)}">
                    <div class="vbw-slot-time">${time}</div>
                    <div class="vbw-slot-status ${status.cls}">${status.text}</div>
                </div>`;
            });

            html += '</div>';
            this.resultsPanel.innerHTML = html;
            this.showPanel(this.resultsPanel);

            this.resultsPanel.querySelectorAll('.vbw-slot').forEach((el) => {
                el.addEventListener('click', () => {
                    const slot = slots.find((s) => s.id === el.dataset.availabilityId);
                    this.selectSlot(slot);
                });
            });
        }

        slotStatus(slot) {
            if (!slot.available) return { text: 'Sold out', cls: 'sold-out' };
            if (slot.vacancies != null && slot.vacancies <= 10) return { text: `${slot.vacancies} left`, cls: 'limited' };
            return { text: 'Available', cls: '' };
        }

        selectSlot(slot) {
            if (!slot) return;
            this.currentSlotData = slot;

            this.bookingPanel.innerHTML = '';
            this.showPanel(this.bookingPanel);
            this.hidePanel(this.resultsPanel);

            this.handoffToVentrata();
        }

        async handoffToVentrata() {
            const bookBtn = this.bookingPanel.querySelector('.vbw-book-btn');
            if (!this.selectedProduct) {
                this.showError('Please select an experience first.');
                return;
            }

            this.clearError();
            if (bookBtn) {
                bookBtn.disabled = true;
                bookBtn.textContent = 'Opening checkout…';
            }
            this.renderHandoffStatus();

            // No server-side booking pre-creation: orders made via OCTO host
            // aren't visible to the Web Checkout SDK (different connection scope).
            const config = buildCheckoutHandoffConfig({
                productId: this.selectedProduct,
                optionId: this.selectedOption,
                dateToPreselect: this.selectedDate || '',
                timeslotToPreselect: extractTimeslotHHMM(
                    this.currentSlotData?.localDateTimeStart || this.currentSlotData?.id || ''
                ),
            });

            const diag = captureVentrataDiagnostics();

            const handoffOk = openVentrataCheckout(config);

            if (!handoffOk) {
                diag.stop();
                this.renderHandoffNotConfigured();
                return;
            }

            const opened = await waitForVentrataModalRendered(6000);
            diag.stop();
            if (opened) {
                this.hidePanel(this.bookingPanel);
                this.hidePanel(this.resultsPanel);
                return;
            }

            const errs = diag.getErrors();
            if (errs.length) {
                this.renderHandoffStatusWithErrors(errs);
            }
        }

        renderHandoffStatus() {
            this.bookingPanel.innerHTML = `
            <div class="vbw-handoff-status">
                <div class="vbw-spinner" aria-hidden="true"></div>
                <h3 class="vbw-handoff-title">Opening secure checkout&hellip;</h3>
                <p>You'll confirm date, time and guests in the next step.</p>
                <details class="vbw-handoff-troubleshoot">
                    <summary>Modal didn&rsquo;t open?</summary>
                    <ul>
                        <li>The current domain must be in the allowed-origins list of your Web Checkout connection in Ventrata. The SDK authenticates by origin/referer, not by API key.</li>
                        <li>Disable ad blockers / privacy extensions, then reload the page.</li>
                        <li>Open your browser console: <code>CHECKOUT_HOST_REQUIRES_CHECKOUT_CONNECTION</code> means this domain is not registered with Ventrata.</li>
                    </ul>
                </details>
                <button type="button" class="vbw-booking-back vbw-handoff-close">Close</button>
            </div>`;
            const closeBtn = this.bookingPanel.querySelector('.vbw-handoff-close');
            if (closeBtn) closeBtn.addEventListener('click', () => this.hidePanel(this.bookingPanel));
        }

        renderHandoffNotConfigured() {
            this.bookingPanel.innerHTML = `
            <div class="vbw-handoff-status">
                <h3 class="vbw-handoff-title">Checkout SDK not available on this page</h3>
                <p>The Ventrata Checkout SDK (<code>ventrata-checkout.min.js</code>) is not loaded here, so we cannot open the booking modal.</p>
                <p>Pick one of:</p>
                <ul>
                    <li>Have your theme load the SDK script tag on this URL (recommended if your theme already loads it on other pages).</li>
                    <li>Or open Settings → Ventrata Booking and set <strong>Inject SDK script</strong> to "Yes" and provide a valid Checkout API key.</li>
                </ul>
                <button type="button" class="vbw-booking-back vbw-handoff-close">Close</button>
            </div>`;
            const closeBtn = this.bookingPanel.querySelector('.vbw-handoff-close');
            if (closeBtn) closeBtn.addEventListener('click', () => this.hidePanel(this.bookingPanel));
        }

        renderHandoffStatusWithErrors(errors) {
            const originRejected = errors.some((e) =>
                String(e.errorCode || '').toUpperCase().includes('CHECKOUT_HOST_REQUIRES_CHECKOUT_CONNECTION')
                || String(e.errorMessage || '').toLowerCase().includes('checkout connection')
            );
            const currentOrigin = (typeof window !== 'undefined' && window.location && window.location.origin) ? window.location.origin : 'this domain';
            const advice = originRejected
                ? `<div class="vbw-handoff-advice"><strong>Action required:</strong> Ventrata rejected the request because <code>${this.esc(currentOrigin)}</code> isn't registered as an allowed origin for your Web Checkout connection. The SDK authenticates by domain (origin/referer), not by API key — so the same key that works on a registered domain (e.g. your staging site) will fail here until this domain is added.<br/><br/>Ask Ventrata to add <code>${this.esc(currentOrigin)}</code> to the allowed-origins list of the Web Checkout connection in your dashboard, then reload this page.</div>`
                : `<div class="vbw-handoff-advice"><strong>Action required:</strong> Ventrata rejected the request. Check the Checkout settings on Ventrata's dashboard (allowed origins, connection status) and try again.</div>`;

            const list = errors.map((e) => {
                const code = e.errorCode ? `<code>${this.esc(e.errorCode)}</code>` : '';
                const msg = this.esc(e.errorMessage || '');
                const status = e.status ? ` <span class="vbw-handoff-status-code">[${e.status}]</span>` : '';
                return `<li>${code}${status} ${msg}</li>`;
            }).join('');

            this.bookingPanel.innerHTML = `
            <div class="vbw-handoff-status">
                <h3 class="vbw-handoff-title">Checkout could not open</h3>
                ${advice}
                <details class="vbw-handoff-troubleshoot" open>
                    <summary>Errors returned by Ventrata</summary>
                    <ul class="vbw-handoff-errors">${list}</ul>
                </details>
                <button type="button" class="vbw-booking-back vbw-handoff-close">Close</button>
            </div>`;
            const closeBtn = this.bookingPanel.querySelector('.vbw-handoff-close');
            if (closeBtn) closeBtn.addEventListener('click', () => this.hidePanel(this.bookingPanel));
        }

        showPanel(panel) { if (panel && panel.classList) panel.classList.add('is-visible'); }
        hidePanel(panel) { if (panel && panel.classList) panel.classList.remove('is-visible'); }
        showLoader() { if (this.loader && this.loader.classList) this.loader.classList.add('is-visible'); }
        hideLoader() { if (this.loader && this.loader.classList) this.loader.classList.remove('is-visible'); }

        showError(msg) {
            this.clearError();
            const el = document.createElement('div');
            el.className = 'vbw-error';
            el.textContent = msg;
            const panel = this.bookingPanel?.classList.contains('is-visible')
                ? this.bookingPanel
                : this.resultsPanel?.classList.contains('is-visible')
                    ? this.resultsPanel
                    : null;
            if (panel) {
                panel.insertAdjacentElement('afterbegin', el);
                return;
            }
            this.el.querySelector('.vbw-bar-row').insertAdjacentElement('afterend', el);
        }

        clearError() {
            this.el.querySelectorAll('.vbw-error').forEach((err) => err.remove());
        }

        formatDate(date) {
            const d = date instanceof Date ? date : new Date(date);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        formatDateLabel(dateStr) {
            const d = new Date(dateStr + 'T12:00:00');
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        formatTime(dateTimeStr) {
            if (!dateTimeStr) return '';
            const timePart = dateTimeStr.includes('T') ? dateTimeStr.split('T')[1] : null;
            if (!timePart) return '';
            const [h, m] = timePart.split(':').map(Number);
            const suffix = h >= 12 ? 'PM' : 'AM';
            const hour12 = h % 12 || 12;
            return `${hour12}:${String(m).padStart(2, '0')} ${suffix}`;
        }

        formatCurrency(amountInCents, currency = 'USD') {
            const amount = amountInCents / 100;
            return new Intl.NumberFormat('en-US', { style: 'currency', currency }).format(amount);
        }

        esc(str) {
            const div = document.createElement('div');
            div.textContent = str || '';
            return div.innerHTML;
        }

        async api(action, data = {}) {
            const formData = new FormData();
            formData.append('action', `ventrata_${action}`);
            formData.append('nonce', ventrataConfig.nonce);
            Object.entries(data).forEach(([key, val]) => formData.append(key, val));
            try {
                const response = await fetch(ventrataConfig.ajaxUrl, { method: 'POST', body: formData, credentials: 'same-origin' });
                return await response.json();
            } catch (e) {
                return { success: false, data: { message: 'Network error.' } };
            }
        }
    }

    /* -----------------------------------------------------------------
     * Auto-initialise all widgets on the page
     * -------------------------------------------------------------- */

    function initWidgets() {
        document.querySelectorAll('.vbw-container').forEach((el) => {
            if (!el._vbwInit) {
                el._vbwInit = true;
                new VentrataWidget(el);
            }
        });
        document.querySelectorAll('.vbw-schedule').forEach((el) => {
            if (!el._vbwInit) {
                el._vbwInit = true;
                new VentrataSchedule(el);
            }
        });
        document.querySelectorAll('.vbw-route-schedule').forEach((el) => {
            if (!el._vbwInit) {
                el._vbwInit = true;
                new VentrataRouteSchedule(el);
            }
        });
        document.querySelectorAll('.vbw-quote').forEach((el) => {
            if (!el._vbwInit) {
                el._vbwInit = true;
                new VentrataQuote(el);
            }
        });
        document.querySelectorAll('.vbw-bar').forEach((el) => {
            if (!el._vbwInit) {
                el._vbwInit = true;
                new VentrataBookingBar(el);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWidgets);
    } else {
        initWidgets();
    }
})();
